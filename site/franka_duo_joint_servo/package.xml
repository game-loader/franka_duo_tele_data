<?xml version="1.0"?>
<package format="3">
  <name>franka_duo_joint_servo</name>
  <version>0.1.0</version>
  <description>Absolute-step joint timeline, Ruckig joint tracker and gated relay feeding the site JointImpedanceController.</description>
  <maintainer email="maintainers@example.invalid">Franka Duo maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen3_cmake_module</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>rclcpp</depend>
  <depend>ruckig</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>franka_mobile_fr3_duo_moveit_config</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
